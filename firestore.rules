rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USERS ───────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Server-managed fields. `access` holds everything about sessions and
      // billing: credits, free sessions, daily counts, membership, Stripe ids
      // (functions/src/lib/access/sessionAccess.ts).
      function serverManagedUserFields() {
        return ['access', 'created_at', 'daily_digest', 'session_recaps'];
      }

      // Users can create their own document, without server-managed fields
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverManagedUserFields());

      // Users can update their own document, but NOT server-managed fields
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(serverManagedUserFields());

      // Users can delete their own document (account deletion)
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ─── ACTIVE CHATS (subcollection) ───
      // `access` records how the session was paid for; only the server writes it.
      match /active_chats/{sessionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['access']);
        allow update: if request.auth != null && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['access']);
      }
      // credit_lots and paid_sessions are server-only (default deny below).

      // ─── LIKED POSTS (subcollection) ───
      match /liked_posts/{postId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── POSTS ───────────────────────────────────────────────────────
    match /posts/{postId} {
      // Anyone authenticated can read public posts; authors can read their own
      allow read: if request.auth != null
        && (resource.data.is_public == true
            || resource.data.uid == request.auth.uid
            || resource.data.authorId == request.auth.uid);

      // Authors can create posts (uid must match)
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid
            || request.resource.data.authorId == request.auth.uid);

      // Authors can update their own posts (visibility toggle only)
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.authorId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['visibility', 'is_public', 'shareToken']);

      // Authors can delete their own posts
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.authorId == request.auth.uid);

      // ─── COMMENTS (subcollection) ───
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && resource.data.commenter_uid == request.auth.uid;
      }
    }

    // ─── DEFAULT: Deny everything else ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
